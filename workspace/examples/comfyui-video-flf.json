{
  "id": "wan22-flf2v",
  "name": "Wan 2.2 first/last frame",
  "kind": "video",
  "protocol": "comfyui",
  "host": { "type": "runpod", "podName": "wan22", "port": 8188, "tunnel": true, "sshKey": "~/.ssh/id_ed25519" },
  "inputs": [
    { "key": "first_frame", "label": "First frame", "accept": "image", "max": 1, "required": true },
    { "key": "last_frame", "label": "Last frame", "accept": "image", "max": 1, "required": true }
  ],
  "params": [
    { "key": "aspect", "label": "Aspect", "type": "select", "options": ["16:9", "9:16", "1:1"], "default": "16:9" },
    { "key": "shortEdge", "label": "Short edge", "type": "select", "options": [480, 720], "default": 480, "suffix": "px" },
    { "key": "seconds", "label": "Duration", "type": "number", "min": 1, "max": 5, "step": 1, "default": 5, "suffix": "s" },
    { "key": "seed", "label": "Seed", "type": "number", "min": 0, "step": 1, "default": null, "placeholder": "random" }
  ],
  "options": { "workflow": "wan22-flf2v.json", "fps": 16, "frameStep": 4 },
  "notes": "Describe the motion between the two frames, not the frames themselves."
}
